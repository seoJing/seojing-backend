generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("article_status")
}

enum ArticleSourceFormat {
  MDX
  BLOCKS

  @@map("article_source_format")
}

enum ArticleBlockType {
  PARAGRAPH
  HEADING
  IMAGE
  CODE
  QUOTE
  CALLOUT
  QUIZ
  RAW_MDX

  @@map("article_block_type")
}

enum ArticleAssetKind {
  COVER
  INLINE_IMAGE
  AUDIO
  VIDEO
  DOWNLOAD
  OTHER

  @@map("article_asset_kind")
}

model Article {
  id                String              @id @default(uuid()) @db.Uuid
  slug              String              @unique
  title             String
  description       String?
  category          String              @default("SEOJing")
  status            ArticleStatus       @default(DRAFT)
  sourceFormat      ArticleSourceFormat @default(MDX) @map("source_format")
  sourceText        String              @map("source_text")
  renderedHtml      String?             @map("rendered_html")
  currentRevisionId String?             @unique @map("current_revision_id") @db.Uuid
  publishedAt       DateTime?           @map("published_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  currentRevision ArticleRevision?  @relation("ArticleCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  revisions       ArticleRevision[] @relation("ArticleRevisions")
  blocks          ArticleBlock[]
  assets          ArticleAsset[]
  comments        ArticleComment[]

  @@index([status, publishedAt])
  @@map("articles")
}

model ArticleRevision {
  id             String              @id @default(uuid()) @db.Uuid
  articleId      String              @map("article_id") @db.Uuid
  revisionNumber Int                 @map("revision_number")
  sourceFormat   ArticleSourceFormat @map("source_format")
  sourceText     String              @map("source_text")
  renderedHtml   String?             @map("rendered_html")
  changeSummary  String?             @map("change_summary")
  authorName     String?             @map("author_name")
  createdAt      DateTime            @default(now()) @map("created_at")

  article           Article        @relation("ArticleRevisions", fields: [articleId], references: [id], onDelete: Cascade)
  currentForArticle Article?       @relation("ArticleCurrentRevision")
  blocks            ArticleBlock[]
  assets            ArticleAsset[]

  @@unique([articleId, revisionNumber])
  @@index([articleId, createdAt])
  @@map("article_revisions")
}

model ArticleBlock {
  id         String           @id @default(uuid()) @db.Uuid
  articleId  String           @map("article_id") @db.Uuid
  revisionId String           @map("revision_id") @db.Uuid
  type       ArticleBlockType
  sortOrder  Int              @map("sort_order")
  content    Json
  plainText  String?          @map("plain_text")
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  article  Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revision ArticleRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  assets   ArticleAsset[]

  @@unique([revisionId, sortOrder])
  @@index([articleId, sortOrder])
  @@map("article_blocks")
}

model ArticleAsset {
  id         String           @id @default(uuid()) @db.Uuid
  articleId  String           @map("article_id") @db.Uuid
  revisionId String?          @map("revision_id") @db.Uuid
  blockId    String?          @map("block_id") @db.Uuid
  kind       ArticleAssetKind
  url        String
  storageKey String?          @map("storage_key")
  altText    String?          @map("alt_text")
  mimeType   String?          @map("mime_type")
  sizeBytes  Int?             @map("size_bytes")
  width      Int?
  height     Int?
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at")

  article  Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revision ArticleRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  block    ArticleBlock?    @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@index([articleId, kind])
  @@index([revisionId])
  @@index([blockId])
  @@map("article_assets")
}

enum UserRole {
  READER
  MODERATOR
  ADMIN

  @@map("user_role")
}

enum CommentKind {
  COMMENT
  QUESTION

  @@map("comment_kind")
}

enum CommentStatus {
  PENDING
  VISIBLE
  HIDDEN

  @@map("comment_status")
}

model User {
  id                  String   @id @default(uuid()) @db.Uuid
  githubId            String   @unique @map("github_id")
  githubLogin         String   @unique @map("github_login")
  displayName         String?  @map("display_name")
  avatarUrl           String?  @map("avatar_url")
  profileUrl          String?  @map("profile_url")
  role                UserRole @default(READER)
  lastAuthenticatedAt DateTime @default(now()) @map("last_authenticated_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  comments ArticleComment[]

  @@index([githubLogin])
  @@map("users")
}

model ArticleComment {
  id               String        @id @default(uuid()) @db.Uuid
  articleId        String        @map("article_id") @db.Uuid
  authorId         String        @map("author_id") @db.Uuid
  parentId         String?       @map("parent_id") @db.Uuid
  kind             CommentKind   @default(COMMENT)
  status           CommentStatus @default(PENDING)
  sectionId        String?       @map("section_id")
  body             String
  moderationReason String?       @map("moderation_reason")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  article Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  ArticleComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies ArticleComment[] @relation("CommentThread")

  @@index([articleId, status, kind, createdAt])
  @@index([articleId, sectionId, status])
  @@index([authorId, createdAt])
  @@index([parentId])
  @@map("article_comments")
}

enum CareerVisibility {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("career_visibility")
}

enum CareerActualStatus {
  OPEN
  CLOSED
  UPCOMING
  UNKNOWN

  @@map("career_actual_status")
}

enum CareerEmploymentType {
  INTERNSHIP
  FULL_TIME
  CONTRACT
  PART_TIME
  OTHER

  @@map("career_employment_type")
}

enum CareerForecastConfidence {
  LOW
  MEDIUM
  HIGH

  @@map("career_forecast_confidence")
}

enum CareerSourceRelationship {
  GENERAL
  ACTUAL_STATUS
  RECRUITMENT_HISTORY
  FORECAST

  @@map("career_source_relationship")
}

model CareerCompany {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  website   String?
  summary   String?
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  opportunities CareerOpportunity[]

  @@map("career_companies")
}

model CareerOpportunity {
  id               String               @id @default(uuid()) @db.Uuid
  companyId        String               @map("company_id") @db.Uuid
  slug             String               @unique
  title            String
  employmentType   CareerEmploymentType @map("employment_type")
  actualStatus     CareerActualStatus   @default(UNKNOWN) @map("actual_status")
  actualStatusAsOf DateTime?            @map("actual_status_as_of")
  location         String?
  summary          String
  description      String?
  applicationUrl   String?              @map("application_url")
  visibility       CareerVisibility     @default(DRAFT)
  publishedAt      DateTime?            @map("published_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  company     CareerCompany              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  history     CareerRecruitmentHistory[]
  forecast    CareerForecast?
  sourceLinks CareerSourceLink[]

  @@index([visibility, publishedAt])
  @@index([companyId, actualStatus])
  @@map("career_opportunities")
}

model CareerRecruitmentHistory {
  id            String             @id @default(uuid()) @db.Uuid
  opportunityId String             @map("opportunity_id") @db.Uuid
  key           String
  openedOn      DateTime?          @map("opened_on") @db.Date
  closedOn      DateTime?          @map("closed_on") @db.Date
  actualStatus  CareerActualStatus @map("actual_status")
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  opportunity CareerOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sourceLinks CareerSourceLink[]

  @@unique([opportunityId, key])
  @@index([opportunityId, openedOn])
  @@map("career_recruitment_history")
}

model CareerForecast {
  id              String                   @id @default(uuid()) @db.Uuid
  opportunityId   String                   @unique @map("opportunity_id") @db.Uuid
  predictedStatus CareerActualStatus       @map("predicted_status")
  confidence      CareerForecastConfidence
  windowStart     DateTime?                @map("window_start") @db.Date
  windowEnd       DateTime?                @map("window_end") @db.Date
  rationale       String
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  opportunity CareerOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sourceLinks CareerSourceLink[]

  @@map("career_forecasts")
}

model CareerSource {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  label       String
  publisher   String?
  url         String
  publishedAt DateTime? @map("published_at")
  retrievedAt DateTime  @map("retrieved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  links CareerSourceLink[]

  @@map("career_sources")
}

model CareerSourceLink {
  id                   String                   @id @default(uuid()) @db.Uuid
  opportunityId        String                   @map("opportunity_id") @db.Uuid
  sourceId             String                   @map("source_id") @db.Uuid
  recruitmentHistoryId String?                  @map("recruitment_history_id") @db.Uuid
  forecastId           String?                  @map("forecast_id") @db.Uuid
  relationship         CareerSourceRelationship
  note                 String?
  createdAt            DateTime                 @default(now()) @map("created_at")

  opportunity        CareerOpportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  source             CareerSource              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  recruitmentHistory CareerRecruitmentHistory? @relation(fields: [recruitmentHistoryId], references: [id], onDelete: Cascade)
  forecast           CareerForecast?           @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, sourceId, relationship, recruitmentHistoryId, forecastId])
  @@index([sourceId])
  @@index([recruitmentHistoryId])
  @@index([forecastId])
  @@map("career_source_links")
}
