# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Production runtime uses launchd with HOST=127.0.0.1 and PORT=4027.

# Database
DATABASE_URL=postgresql://seojing:***@localhost:5432/seojing_backend?schema=public

# Public contract
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173,https://seojing.com

# Shared internal Python worker capability bridge.
# Keep this loopback-only. Public traffic enters through this Node API.
PYTHON_WORKER_ENABLED=false
PYTHON_WORKER_BASE_URL=http://127.0.0.1:4037
PYTHON_WORKER_TIMEOUT_MS=10000
PYTHON_WORKER_RETRY_ATTEMPTS=1

# Optional admin credentials. Leave unset until the feature is enabled.
# ADMIN_API_TOKEN=<opaque-admin-token>

# README Lab (opt-in; leave disabled until frontend and backend are released together).
# README_LAB_ENABLED=1
# README_LAB_INVITES=<comma-separated-invitation-codes-at-least-16-characters>
# README_LAB_ENGINE=jev-focus
# Engines: laya (also the omitted default), jev (legacy prefix), jev-focus (inquiry reader).
# TYPESAFE_API_KEY=<server-only-typesafe-key>
# README_CODEX_BIN=codex
# README_CODEX_MODEL=<optional-model-override>
# README_JEV_PYTHON=/usr/bin/python3
# README_FOCUS_JEV_SCRIPT=<optional-focus-worker-path>
# README_JEV_SCRIPT is only used by the legacy jev engine, never jev-focus.
