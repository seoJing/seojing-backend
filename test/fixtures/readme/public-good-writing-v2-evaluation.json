{
  "version": "public-good-writing-quality-v2",
  "date": "2026-10-06",
  "base_commit": "4092aeed07462205b2b009dce6c7f03aae62a9b9",
  "purpose": "Offline source-grounded reader quality improvement; not fine-tuning, a hiring verdict or an unattended-release approval.",
  "corpus_manifests": [
    "public-good-writing-v1.json",
    "public-good-writing-transfer-v1.json"
  ],
  "evaluation_scope": [
    "Three published expert-rated essays used for development; one later-selected retail/sales transfer case. These public texts may exist in model pretraining.",
    "Original historic adverts unavailable: role and original application questions form explicitly reconstructed briefs.",
    "Expert grade/commentary, selection rationale and expected outcomes were excluded from model input. Full texts and raw outputs remain ignored local artifacts.",
    "All failed attempts retained. No company/sample-specific production rules or forced memo/question counts.",
    "V4 generated fresh profiles. V5/V6 freeze those same profiles to compare reading/report changes; cached-run times exclude new profile generation.",
    "The final report disclosure change is deterministic rendering only; original V6 model outputs remain untouched and separate replay preserves facts, citations, categories, notes and question state.",
    "V6 execution completion is not automatic quality acceptance: Bosch had foreign-language prose and is explicitly rejected below. The observed draft was then replayed once to exercise the bounded live correction path on the identical report input.",
    "Final source has two report-only changes after full V6 runs: explicit reading/final distinction for directly linked unresolved notes, and Korean-prose validation/correction. Reader/profile source hashes remain those of V6. Transfer-final-v2 used grounded v23, not final v24.",
    "Expert scores select public examples, not model ground truth; acceptance uses what the actual source states and what the reconstructed question asks."
  ],
  "guards": {
    "threshold": 0.75,
    "reader_request_ceiling": 600,
    "reader_input_token_ceiling": 2000000,
    "standalone_evidence_note_ceiling": 12,
    "source_prefix_only": true,
    "independent_exact_quote_and_full_prefix_audits": true,
    "no_fine_tuning": true,
    "no_deployment": true
  },
  "acceptance_frozen_before_edits": {
    "baseline_commit": "4092aeed07462205b2b009dce6c7f03aae62a9b9",
    "frozen_before_edits": true,
    "public_cases": {
      "lg_hr": {
        "recognize": [
          "HR preparation activities/motivation u5-u8",
          "statistics/tool learning and grades u11-u12",
          "current study and future exam distinguished u17"
        ],
        "forbid": [
          "asserting past HR employment",
          "invented applied-analysis project",
          "exam success/qualification"
        ],
        "question_rule": "Recognize available partial support for any broad question; no forced complete or question quota."
      },
      "hynix_process": {
        "recognize": [
          "stated research goal attainment u9",
          "repeated process experiments u30",
          "individual teaching and shared mural completion u43/u46"
        ],
        "forbid": [
          "sole authorship or hiring verdict",
          "invented experimental conditions",
          "sole leadership of team outcome"
        ],
        "note_rule": "Source-based recognition across these independent activities, not arbitrary per-criterion note quotas."
      },
      "bosch_scm": {
        "profile": "Consistent content-prompt versus submission classification; preserve required/optional/conditional clauses. Fresh pipeline must not need user retry to repair one semantic classification error.",
        "recognize": [
          "personal logistics coordination",
          "reported comparison result without changing statistic"
        ],
        "forbid": [
          "20%-to-under5% represented as15% relative reduction",
          "optional experience becoming mandatory"
        ]
      }
    },
    "negative_controls": [
      "other actor",
      "different experience",
      "future-only plan",
      "later explicit retraction",
      "same-fact paraphrase",
      "unsubstantiated result"
    ],
    "guards": [
      "no provider threshold reduction",
      "no sample/company branching",
      "no future source",
      "exact evidence and all final audits",
      "600 request / 2M reader token budget retained",
      "old artifacts never overwritten"
    ]
  },
