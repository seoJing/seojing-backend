{
  "name": "seojing-backend",
  "packageManager": "pnpm@10.4.1",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Portfolio-grade content/community backend for SEOJing.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ignore-pattern '.local/**'",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "mdx:ingest": "tsx scripts/ingest-mdx.ts",
    "mdx:import-drafts": "tsx scripts/import-mdx-drafts.ts",
    "study:migration-audit": "tsx scripts/audit-study-migration.ts",
    "db:local:start": "bash scripts/local-postgres.sh start",
    "db:local:stop": "bash scripts/local-postgres.sh stop",
    "db:local:status": "bash scripts/local-postgres.sh status",
    "db:backup": "tsx scripts/backup-postgres.ts",
    "openapi:check": "tsx scripts/check-openapi.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^6.19.0",
    "fastify": "^5.12.5",
    "mammoth": "1.13.0",
    "parse5": "7.3.0",
    "pdf-parse": "2.4.5",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "prisma": "^6.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.15"
  }
}
